#!/usr/bin/env nu
# terapia — therapy sessions for your agent's past lives.
#
# Stable, typed query CLI over agent-session JSONL corpora. One command per
# answer, so you never write another bespoke heredoc parser over session files.
#
# Sources (scanned together; --source filters):
#   pi    ~/.pi/agent/sessions   ($env.TERAPIA_SESSIONS)
#   omp   ~/.omp/agent/sessions  ($env.TERAPIA_OMP_SESSIONS)
#
# Commands:
#   list    [--project P] [--since D] [--until D] [--source S]  sessions as JSON
#   tools   <session-id> [--tool T] [--errors-only]             tool calls + results
#   errors  <session-id> | --all [--group-by K] [--source S]    classified tool errors
#   stats   <session-id> | --all [--source S]                   counts + error breakdown
#   raw     <session-id> [--type T]                             raw JSONL entries
#
# Output is JSON on stdout. Errors go to stderr; exit 1 on failure.

# Corpora to scan. Every output row carries `source`; omp nests subagent
# transcripts (<project>/<session>/<agent>.jsonl) under the same decoding.
def sources [] {
  [
    {source: "pi", dir: ($env.TERAPIA_SESSIONS? | default ($nu.home-dir | path join ".pi" "agent" "sessions"))},
    {source: "omp", dir: ($env.TERAPIA_OMP_SESSIONS? | default ($nu.home-dir | path join ".omp" "agent" "sessions"))},
  ]
  | where {|s| ($s.dir | path exists)}
}

def cache-dir [] {
  $env.TERAPIA_CACHE? | default ($nu.cache-dir | path join "terapia")
}

# Cache key: path + mtime + size — any edit to the file changes it.
def cache-key [path: string] {
  let st = (ls $path | first)
  # v2: cache rows gained `source` — old entries must not leak back in.
  let sig = $"v2|($path)|($st.modified? | format date '%s.%f')|($st.size? | default 0)"
  $sig | hash md5
}

# Single-file scan with an mtime-keyed cache: {meta, errors} (errors = classified rows).
def cached-scan [rec] {
  let key = (cache-key $rec.path)
  let cfile = ((cache-dir) | path join $"($key).json")
  if ($cfile | path exists) {
    let cached = (try { open --raw $cfile | from json } catch { null })
    if $cached != null { return $cached }
    rm -f $cfile  # corrupt entry: rebuild instead of crashing downstream
  }
  let sc = (scan-file $rec)
  let rows = (error-rows $sc.meta $sc.pairs)
  mkdir (cache-dir)
  ({meta: $sc.meta, errors: $rows} | to json | save -f $cfile)
  {meta: $sc.meta, errors: $rows}
}

def cached-all [] {
  session-files | each {|rec| cached-scan $rec }
}

# pi encodes "/" as "--"; omp as "-" (home-relative). Trim the leading marker first.
def project-from-dir [source: string, name: string] {
  let sep = (if $source == "omp" { "-" } else { "--" })
  $name | str trim --char "-" | str replace --all $sep "/"
}

def parse-jsonl [path: string] {
  open --raw $path
  | lines
  | each {|l| try { $l | from json } catch { null } }
  | compact
}

# One record per transcript: {source, path, project, agent}.
# pi: <project>/<session>.jsonl — omp adds <project>/<session>/<agent>.jsonl subagents.
def session-files [] {
  sources
  | each {|s|
      let src = $s.source
      let mains = (glob ($s.dir | path join "*" "*.jsonl")
        | sort
        | each {|p| {
            source: $src,
            path: $p,
            project: (project-from-dir $src ($p | path dirname | path basename)),
            agent: null,
          }})
      if $src == "omp" {
        let subs = (glob ($s.dir | path join "*" "*" "*.jsonl")
          | sort
          | each {|p| {
              source: $src,
              path: $p,
              project: (project-from-dir $src ($p | path dirname | path dirname | path basename)),
              agent: ($p | path parse | get stem),
            }})
        $mains | append $subs
      } else {
        $mains
      }
    }
  | flatten
  | sort-by path
}

def meta-from-entries [entries rec] {
  let header = ($entries | where {|e| $e.type? == "session"} | first)
  let titles = ($entries | where {|e| $e.type? == "title" and ($e.title? | default "" | str length) > 0})
  let title = (if ($titles | is-empty) { $header.title? } else { $titles | last | get title })
  let msgs = ($entries | where {|e| $e.type? == "message"} | get message)
  let tool_calls = ($msgs
    | where {|m| $m.role? == "assistant"}
    | each {|m| $m.content? | default [] | where {|c| $c.type? == "toolCall"} | length }
    | reduce -f 0 {|it, acc| $acc + $it })
  {
    id: ($header.id?),
    source: $rec.source,
    project: $rec.project,
    agent: $rec.agent,
    file: $rec.path,
    timestamp: ($header.timestamp?),
    cwd: ($header.cwd?),
    title: $title,
    messages: ($msgs | where {|m| $m.role? != "toolResult"} | length),
    tool_calls: $tool_calls,
    errors: ($msgs | where {|m| $m.role? == "toolResult" and $m.isError? == true} | length),
  }
}

# Cheap: read a small prefix. pi has the session header on line 1; omp puts a
# `title` line first (its `session` entry carries id/timestamp/cwd as usual).
def header-of [rec] {
  let hs = (^head -n 20 $rec.path
    | lines
    | each {|l| try { $l | from json } catch { null } }
    | compact
    | where {|e| $e.type? == "session"})
  let h = (if ($hs | is-empty) { {id: null} } else { $hs | first })
  {
    id: ($h.id?),
    source: $rec.source,
    project: $rec.project,
    agent: $rec.agent,
    file: $rec.path,
    timestamp: ($h.timestamp?),
    cwd: ($h.cwd?),
  }
}

def sessions-headers [] {
  session-files | each {|rec| header-of $rec }
}

def resolve-session [session_id: string] {
  let matches = (sessions-headers
    | where {|s| $s.id? | default "" | str starts-with $session_id })
  if ($matches | is-empty) {
    error make {msg: $"session not found: ($session_id)"}
  }
  if ($matches | length) > 1 {
    let ids = ($matches | get id | str join ", ")
    error make {msg: $"ambiguous prefix ($session_id): ($ids)"}
  }
  $matches | first
}

def result-text [content] {
  $content | default []
  | each {|c| if ($c.type? == "text") { $c.text? | default "" } else { "" } }
  | str join "\n"
}

def pair-from-entries [entries] {
  mut pending = {}
  mut out = []
  for e in $entries {
    if ($e.type? != "message") { continue }
    let m = ($e.message?)
    if ($m.role? == "assistant") {
      let calls = ($m.content? | default [] | where {|c| $c.type? == "toolCall"})
      for c in $calls { $pending = ($pending | upsert $c.id $c) }
    } else if ($m.role? == "toolResult") {
      let call = ($pending | get -o $m.toolCallId?)
      $pending = ($pending | reject -o $m.toolCallId?)
      $out = ($out | append {call: $call, result: $m, timestamp: ($e.timestamp?)})
    }
  }
  $out
}

def classify-error [text: string] {
  let t = ($text | str lowercase)
  if ($t =~ 'oldtext|old_string|not found in|overlap') { "edit_mismatch" } else if ($t =~ 'no such file|enoent|does not exist|not found:') { "file_not_found" } else if ($t =~ 'unrecognized|invalid flag|unknown flag|no such option|unknown subcommand') { "cli_flag_drift" } else if ($t =~ 'traceback|stacktrace|panic:|syntaxerror|typeerror|nameerror|referenceerror') { "lang_runtime" } else if ($t =~ 'timeout|connection refused|econnrefused|connection reset|enotfound') { "network" } else if ($t =~ 'exit code|exited with code|non-zero exit') { "exit_nonzero" } else { "other" }
}

def in-window [s since until] {
  let ts = ($s.timestamp? | default "")
  if ($since != null and ($ts | str substring 0..9) < $since) { return false }
  if ($until != null and ($ts | str substring 0..9) > $until) { return false }
  true
}

def group-counts [rows key] {
  $rows
  | reduce -f {} {|e, acc|
      let k = ($e | get $key)
      let v = (($acc | get -o $k) | default 0)
      $acc | upsert $k ($v + 1)
    }
}

# One pass per file: {meta, pairs} — used by --all commands.
def scan-file [rec] {
  let entries = (parse-jsonl $rec.path)
  {
    meta: (meta-from-entries $entries $rec),
    pairs: (pair-from-entries $entries),
  }
}

def error-rows [s pairs] {
  $pairs
  | where {|p| $p.result.isError? == true}
  | each {|p| {
      session: $s.id,
      source: $s.source,
      project: $s.project,
      tool: ($p.result.toolName? | default ($p.call?.name?)),
      class: (classify-error (result-text $p.result.content?)),
      input: ($p.call?.arguments?),
      result: (result-text $p.result.content?),
      timestamp: $p.timestamp,
    }}
}

def "main list" [--project: string, --since: string, --until: string, --source: string] {
  cached-all | get meta
  | where {|s| $source == null or $s.source == $source}
  | where {|s| $project == null or $s.project == $project}
  | where {|s| in-window $s $since $until}
  | to json
}

def "main tools" [session_id: string, --tool: string, --errors-only] {
  let s = (resolve-session $session_id)
  pair-from-entries (parse-jsonl $s.file)
  | where {|p| $tool == null or ($p.call?.name? == $tool) or ($p.result.toolName? == $tool)}
  | where {|p| not $errors_only or ($p.result.isError? == true)}
  | each {|p| {
      tool: ($p.call?.name? | default ($p.result.toolName?)),
      input: ($p.call?.arguments?),
      isError: ($p.result.isError?),
      result: (result-text $p.result.content?),
      timestamp: $p.timestamp,
    }}
  | to json
}

def "main errors" [session_id?: string, --all, --group-by: string, --source: string] {
  if ($all == false and $session_id == null) {
    error make {msg: "usage: terapia errors <session-id> | --all"}
  }
  let rows = (if $all {
    cached-all
    | where {|sc| $source == null or $sc.meta.source == $source}
    | get errors | flatten
  } else {
    let s = (resolve-session $session_id)
    error-rows $s (pair-from-entries (parse-jsonl $s.file))
  })
  if $group_by != null {
    group-counts $rows $group_by | to json
  } else {
    $rows | to json
  }
}

def "main stats" [session_id?: string, --all, --source: string] {
  if ($all == false and $session_id == null) {
    error make {msg: "usage: terapia stats <session-id> | --all"}
  }
  if $all {
    let scans = (cached-all
      | where {|sc| $source == null or $sc.meta.source == $source})
    let rows = ($scans | get errors | flatten)
    {
      sessions: ($scans | length),
      tool_calls: (if ($scans | is-empty) { 0 } else { $scans | get meta | get tool_calls | math sum }),
      errors: ($rows | length),
      by_class: (group-counts $rows "class"),
      by_source: (group-counts ($scans | get meta) "source"),
    } | to json
  } else {
    let s = (resolve-session $session_id)
    let entries = (parse-jsonl $s.file)
    let meta = (meta-from-entries $entries ($s | merge {path: $s.file}))
    let rows = (error-rows $meta (pair-from-entries $entries))
    {
      session: $s.id,
      source: $s.source,
      messages: $meta.messages,
      tool_calls: $meta.tool_calls,
      errors: ($rows | length),
      by_class: (group-counts $rows "class"),
    } | to json
  }
}

def "main raw" [session_id: string, --type: string] {
  let s = (resolve-session $session_id)
  parse-jsonl $s.file
  | where {|e| $type == null or $e.type? == $type}
  | each {|e| $e | to json -r }
  | str join (char nl)
}

def main [] {
  print "usage: terapia <list|tools|errors|stats|raw> ... — see terapia --help"
}
