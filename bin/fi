#!/usr/bin/env bash
# Purpose: Launch pi with free OpenRouter models and a bounded runtime.
# Responsibilities: Resolve models, preserve pi arguments, redact auth diagnostics.
# Rationale: GH #1 uses sequential parsing to preserve literal argv and exact IDs.
#
# Wrapper that only allows free models (including openrouter/free) with simple aliases.
# Triggers a subset of pi functionality focused on free OpenRouter models.
#
# USAGE:
#   fi <alias|model-id> [options] [prompt]
#   fi run [--model <alias|model-id>] [options] [prompt]
#
# SUBCOMMANDS:
#   doctor    Show system status and free model compatibility info
#   list       List available free models (alias: ls)
#   run       Pass through to pi with the default or --model selection
#
# SIMPLE ALIASES:
#   laguna     -> poolside/laguna-s-2.1:free
#   lagunar    -> poolside/laguna-xs-2.1:free
#   nemo       -> nvidia/nemotron-3-ultra-550b-a55b:free
#   nemotron   -> nvidia/nemotron-3.5-lightning:free
#   nemox      -> nvidia/nemotron-3.5-super-vl:free
#   nemo2      -> nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   inkling    -> thinkingmachines/inkling:free
#   inkling-s  -> thinkingmachines/inkling-small:free
#   flint      -> recursive/flint-v1.0:free
#   openrouter -> openrouter/free

set -euo pipefail

# Free model aliases mapping
declare -A FREE_MODELS=(
    [laguna]="poolside/laguna-s-2.1:free"
    [lagunar]="poolside/laguna-xs-2.1:free"
    [nemo]="nvidia/nemotron-3-ultra-550b-a55b:free"
    [nemotron]="nvidia/nemotron-3.5-lightning:free"
    [nemox]="nvidia/nemotron-3.5-super-vl:free"
    [nemo2]="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
    [inkling]="thinkingmachines/inkling:free"
    [inkling-s]="thinkingmachines/inkling-small:free"
    [flint]="recursive/flint-v1.0:free"
    [openrouter]="openrouter/free"
)

# Working free models (from testing)
declare -A WORKING_MODELS=(
    [poolside/laguna-s-2.1:free]="true"
    [poolside/laguna-xs-2.1:free]="true"
    [nvidia/nemotron-3-ultra-550b-a55b:free]="true"
    [nvidia/nemotron-3.5-lightning:free]="true"
    [nvidia/nemotron-3.5-super-vl:free]="true"
    [nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free]="true"
    [thinkingmachines/inkling:free]="true"
    [thinkingmachines/inkling-small:free]="true"
    [recursive/flint-v1.0:free]="true"
    [openrouter/free]="true"
)

# Default timeout in seconds
DEFAULT_TIMEOUT="900"

# Show usage
show_help() {
    cat << 'EOF'
fi — Free model wrapper for pi coding agent

USAGE:
  fi <alias|model-id> [options] [prompt]
  fi run [--model <alias|model-id>] [options] [prompt]

SUBCOMMANDS:
  doctor           Show system status and free model compatibility info
  list|ls          List available free models
  run              Launch pi (defaults to openrouter/free)

SIMPLE ALIASES (for --model):
  laguna           -> poolside/laguna-s-2.1:free
  lagunar          -> poolside/laguna-xs-2.1:free
  nemo             -> nvidia/nemotron-3-ultra-550b-a55b:free
  nemotron         -> nvidia/nemotron-3.5-lightning:free
  nemox            -> nvidia/nemotron-3.5-super-vl:free
  nemo2            -> nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
  inkling          -> thinkingmachines/inkling:free
  inkling-s        -> thinkingmachines/inkling-small:free
  flint            -> recursive/flint-v1.0:free
  openrouter       -> openrouter/free

EXAMPLES:
  fi laguna "hello world"               # Use laguna alias
  fi nemo2 "write a python script"        # Use nemo2 alias
  fi --list                              # List free models
  fi doctor                              # Show system info
  fi nemo "list" --model nemo             # Pi's list-models with nemo alias

CONSTRAINTS:
- Only free model IDs (ending with :free) and openrouter/free are allowed
- Aliases are for convenience only; actual model IDs follow openrouter naming
- All other pi parameters are passed through unchanged
- Use --print for a one-shot run; pi session flags are forwarded unchanged
- Use --timeout <seconds> to set a timeout (default 900 / 15 min)
EOF
}

# Show system doctor info
doctor() {
    local pi_path
    pi_path="$(command -v pi 2>/dev/null || echo 'NOT FOUND')"
    local session_dir="$HOME/.pi/agent/sessions"
    local cache_dir="$HOME/.cache/terapia"

    cat << EOF
== Free Model pi Wrapper (fi) Doctor Report ==

PI STATUS:
- Executable: $pi_path
- Session directory: $session_dir (exists: $(test -d "$session_dir" && echo "YES" || echo "NO"))
- Cache directory: $cache_dir (exists: $(test -d "$cache_dir" && echo "YES" || echo "NO"))

AUTHENTICATION:
$(if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
    echo "- OpenRouter auth: environment key present (redacted)"
elif [[ -f "$HOME/.pi/agent/auth.json" ]]; then
    echo "- OpenRouter auth: auth file present (contents not displayed)"
else
    echo "- OpenRouter auth: not detected"
fi)

WORKING FREE MODELS:
$(for model in "${!WORKING_MODELS[@]}"; do
    echo "- $model"
done | sort)

ALLOWED ALIASES:
$(for alias in "${!FREE_MODELS[@]}"; do
    echo "  $alias -> ${FREE_MODELS[$alias]}"
done)

USAGE NOTES:
- Use 'fi <alias> <prompt>' to run with a free model
- Use 'fi ls' or 'fi list' to list free models
- Use 'fi doctor' for this system info
- Use 'fi nemo2 "write a python script"' to test a free model
- All other pi parameters (--session, --name, --thinking, etc.) are forwarded

SESSION PERSISTENCE:
$(if [ -d "$session_dir" ]; then
    local session_count
    session_count="$(find "$session_dir" -name "*.jsonl" 2>/dev/null | wc -l)"
    echo "- Existing sessions: $session_count"
else
    echo "- No session directory found"
fi)
EOF
}

# List free models
list_models() {
    cat << 'EOF'
AVAILABLE FREE MODELS:

Simple Aliases (recommended):
  laguna           poolside/laguna-s-2.1:free    - Large general purpose
  lagunar          poolside/laguna-xs-2.1:free   - Smaller general purpose
  nemo             nvidia/nemotron-3-ultra-550b-a55b:free - Largest nemotron
  nemotron         nvidia/nemotron-3.5-lightning:free - Fastest nemotron
  nemox            nvidia/nemotron-3.5-super-vl:free - Vision-capable nemotron
  nemo2            nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free - Reasoning nemotron
  inkling          thinkingmachines/inkling:free          - Original inkling model
  inkling-s        thinkingmachines/inkling-small:free    - Smaller inkling
  flint            recursive/flint-v1.0:free              - Recursive's open-weight coding model
  openrouter       openrouter/free                - Generic free model

All models require a free-tier or paid OpenRouter account.
Most support tool calling and reasoning (check model details at openrouter.ai).

RUNNING:
  fi laguna "hello world"          # Use laguna alias
  fi nemo2 "write a python script"   # Use nemo2 alias
  fi nemo "list"                   # Pi's list-models with nemo
EOF
}

# Map aliases without reading unset associative-array entries under nounset.
resolve_model() {
    local model_arg="$1"
    [[ -n "$model_arg" ]] || { echo "Empty model ID" >&2; return 2; }
    if [[ -n "${FREE_MODELS[$model_arg]:-}" ]]; then
        printf '%s\n' "${FREE_MODELS[$model_arg]}"
    elif [[ "$model_arg" == "openrouter/free" || "$model_arg" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+:free$ ]]; then
        printf '%s\n' "$model_arg"
    else
        echo "Error: '$model_arg' is not a free model ID or recognized alias" >&2
        return 2
    fi
}

main() {
    case "${1:-}" in
        doctor|--doctor|-d) doctor; return ;;
        list|ls|--list|-l) list_models; return ;;
        --help|-h|help|"") show_help; return ;;
    esac

    local model_arg="openrouter/free" timeout_value="$DEFAULT_TIMEOUT"
    local resolved_model has_name=0
    local -a pi_args=()
    if [[ "$1" == "run" ]]; then
        shift
    elif [[ "$1" != -* ]]; then
        # The first positional argument selects a model; use `run` for prompts.
        model_arg="$1"
        shift
    fi

    while (( $# )); do
        case "$1" in
            --model|--timeout|--provider)
                [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || {
                    echo "$1 needs a value" >&2; return 2;
                }
                case "$1" in
                    --model) model_arg="$2" ;;
                    --timeout) timeout_value="$2" ;;
                    --provider)
                        [[ "$2" == openrouter ]] || {
                            echo "fi requires provider openrouter" >&2; return 2;
                        } ;;
                esac
                shift 2 ;;
            --model=*) model_arg="${1#--model=}"; shift ;;
            --timeout=*) timeout_value="${1#--timeout=}"; shift ;;
            --provider=*)
                [[ "${1#--provider=}" == openrouter ]] || {
                    echo "fi requires provider openrouter" >&2; return 2;
                }
                shift ;;
            --) pi_args+=("$@"); break ;;
            --name|-n|--api-key|--mode|--session|--session-id|--fork|--session-dir|--tools|-t|--exclude-tools|-xt|--thinking|--system-prompt|--append-system-prompt|--extension|-e|--skill|--prompt-template|--theme|--models|--export)
                [[ $# -ge 2 ]] || { echo "$1 needs a value" >&2; return 2; }
                [[ "$1" != --name && "$1" != -n ]] || has_name=1
                pi_args+=("$1" "$2")
                shift 2 ;;
            --name=*) has_name=1; pi_args+=("$1"); shift ;;
            *) pi_args+=("$1"); shift ;;
        esac
    done

    [[ "$timeout_value" =~ ^[0-9]+([.][0-9]+)?$ && ! "$timeout_value" =~ ^0+([.]0+)?$ ]] || {
        echo "--timeout must be positive finite seconds" >&2; return 2;
    }
    resolved_model="$(resolve_model "$model_arg")" || return 2
    if [[ $has_name -eq 0 ]]; then
        pi_args=(--name "fi-$(date +%Y%m%d-%H%M%S)" "${pi_args[@]}")
    fi
    # Qualify the provider separately from the complete upstream model ID.
    # exec lets an outer runner signal timeout, which relays to its process group.
    exec timeout --kill-after=1s "$timeout_value" pi --provider openrouter \
        --model "openrouter/$resolved_model" "${pi_args[@]}"
}

main "$@"
