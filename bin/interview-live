#!/usr/bin/env python3
# Purpose: Live Mom Test interview copilot — transcribe a meeting (mic + system
#   audio, diarized) in rolling windows and have pi suggest follow-up questions,
#   wrapped in a reactive curses dashboard (participant count, live transcript,
#   prioritized question/topic queue).
# Responsibilities (thin coordinator):
#   - Wire the modular pipeline: capture (interview_live_capture), transcription
#     (interview_live_whisper), suggestions (interview_live_suggest), event log
#     (interview_live_events), queue model (interview_live_core), batch trigger
#     policy (interview_live_trigger), dashboard (tui)
#   - Own the worker loop (offsets, file artifacts, TUI state mirroring) and the
#     TUI worker-thread orchestration
#   - Run the optional --question-model attempt under a soft budget and retry
#     once on --pi-model (suggest_fallback), so a slow strong model never stalls
#     the suggestion path
#   - Append a chronological events.jsonl audit trail for the whole session
# Rationale: canticos-59c / canticos-c02 / canticos-9x1 — the Mom Test demands
#   digging into specific past instances; the copilot keeps questions grounded in
#   what was actually said, and the dashboard keeps the interviewer oriented
#   without touching the keyboard. The Ro5 review (verified) pushed the 398-line
#   monolith into per-concern modules so capture/whisper/suggest/events can each
#   improve independently; an event log makes sessions auditable and replayable.
import argparse
import json
import os
import queue
import re
import signal
import subprocess
import sys
import threading
import time
from collections import deque
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import interview_live_capture as cap  # noqa: E402
import interview_live_core as core  # noqa: E402
import interview_live_diarize as dia  # noqa: E402
import interview_live_events as evlog  # noqa: E402
import interview_live_suggest as sug  # noqa: E402
import interview_live_tui as tui  # noqa: E402
import interview_live_trigger as trig  # noqa: E402
import interview_live_whisper as whisper  # noqa: E402


class InterviewLive:
    def __init__(self, args):
        self.args = args
        # Ordered session storage (canticos-det): --out is the ROOT; artifacts
        # live in <root>/<session>/ so reruns never mix sessions (the flat
        # reuse caused the leftover-capture.wav bug fixed in 1ffe2f6).
        self.out = Path(args.out or os.environ.get("INTERVIEW_DIR") or str(Path.home() / "Interviews"))
        self.out.mkdir(parents=True, exist_ok=True)
        self.session_name = (args.session or f"interview-{time.strftime('%Y%m%d-%H%M%S')}")
        self.work = self.out / self.session_name
        self.work.mkdir(parents=True, exist_ok=True)
        self.transcript_path = self.work / "transcript.txt"
        self.questions_path = self.work / "questions.md"
        self.queue_path = self.work / "queue.json"
        self.speakers_path = self.work / "speakers.json"
        self.speaker_names = self._load_speaker_names(args.speaker)
        self.events_path = self.work / "events.jsonl"
        self.capture_path = self.work / "capture.wav"
        self.whisper = args.whisper_model or os.environ.get("WHISPER_MODEL") or default_whisper_model()
        self.ffmpeg_proc = None
        self._ffmpeg_err_fh = None
        self._replay_pos_ms = 0
        self._replay_total_ms = 0
        self._suggest_q = queue.Queue()
        self._suggest_lock = threading.Lock()
        self._suggest_seq = 0   # newest enqueued batch id (stale-drop, canticos-2iv)
        self._suggest_thread = None
        self.interrupted = False
        self.participants = args.participants
        # canticos-47b: thread lifecycle + discovery-slot coverage are session
        # state; the queue annotates every ingested question with both refs.
        self.threads = core.ThreadTracker()
        self.slots = core.SlotModel()
        self.queue = core.Queue(threads=self.threads, slots=self.slots)
        # canticos-ap3/ate: rendered transcript lines for grounds validation and
        # the stateless rolling window; bounded so a long interview stays cheap.
        self.recent_lines = deque(maxlen=sug.RECENT_WINDOW_LINES)
        self._recent_lock = threading.Lock()  # worker appends, suggester snapshots
        self.ui = None  # tui.TuiState when the dashboard is active
        # Plain stdout parity (canticos-wrl): the lead card's dwell/hysteresis
        # bookkeeping lives in a TuiState even without curses, so batches share
        # one stable NEXT recommendation.
        self.board_ui = tui.TuiState(queue=self.queue)
        self.log = evlog.EventLog(self.events_path)
        self.started_at = time.time()
        self.board_ui.started = self.started_at
        self.board_ui.participants = args.participants

    def _load_speaker_names(self, specs):
        """Merge speakers.json with --speaker specs; persist when specs are
        given (canticos-uzv). id 0 defaults to 'You' once any naming is active
        so transcripts read naturally."""
        names = {}
        if self.speakers_path.exists():
            try:
                loaded = json.loads(self.speakers_path.read_text())
                if isinstance(loaded, dict):
                    names = {str(k): v for k, v in loaded.items()
                             if isinstance(v, dict) and v.get("name")}
            except (json.JSONDecodeError, OSError):
                names = {}
        if specs:
            names.update({str(k): {"name": v} for k, v in specs.items()})
            names.setdefault("0", {"name": "You"})
            self.speakers_path.write_text(json.dumps(names, indent=2, ensure_ascii=False))
        return names

    # -- capture ---------------------------------------------------------------
    def start_capture(self):
        if self.args.from_file:
            mode, cmd = "replay", cap.build_replay_cmd(self.args.from_file, self.capture_path)
        elif self.args.replay:
            mode, cmd = "replay-live", cap.build_replay_cmd(self.args.replay, self.capture_path)
        else:
            mode = "live"
            mic, monitor = cap.resolve_devices()
            cmd = cap.build_live_cmd(mic, monitor, self.capture_path)
        self.ffmpeg_proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                             stderr=self._open_ffmpeg_log())
        if self.ui:
            self.ui.capture = mode
        self.log.emit("capture_start", mode=mode,
                      source=str(self.args.from_file) if self.args.from_file else None)

    def _open_ffmpeg_log(self):
        """ffmpeg's stderr lands in <out>/ffmpeg.log so capture failures are
        diagnosable after the fact (DEVNULL lost every exit reason)."""
        if self._ffmpeg_err_fh:
            self._ffmpeg_err_fh.close()
        self._ffmpeg_err_fh = open(self.out / "ffmpeg.log", "w")
        return self._ffmpeg_err_fh

    def stop_capture(self):
        if self.ffmpeg_proc and self.ffmpeg_proc.poll() is None:
            self.ffmpeg_proc.terminate()
            try:
                self.ffmpeg_proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.ffmpeg_proc.kill()
        if self._ffmpeg_err_fh:
            self._ffmpeg_err_fh.close()
            self._ffmpeg_err_fh = None
        if self.ui:
            self.ui.capture = "stopped"

    # -- suggestions -----------------------------------------------------------
    def _start_suggester(self):
        """Background thread running pi batches so the transcription loop never
        blocks on suggestions (the TUI transcript froze for 8-20s per batch).
        canticos-2iv: when newer batches queue up while pi is busy, older ones
        are skipped, but their lines ride along with the newest batch — a stale
        drop must never remove transcript segments from the model's view."""
        def loop():
            carry = []
            while True:
                item = self._suggest_q.get()
                if item is None:
                    break
                if isinstance(item, dict) and item.get("kind") == "followup":
                    try:
                        self.generate_followup(item["question"], item["answer"])
                    except Exception as e:  # noqa: BLE001 — follow-up failures are logged, never fatal
                        try:
                            self.log.emit("followup_error",
                                          reason=f"thread:{type(e).__name__}:{e}")
                        except Exception:  # noqa: BLE001 — log may be closing
                            pass
                    continue
                seq, lines = item
                carry.extend(lines)
                with self._suggest_lock:
                    newest = self._suggest_seq
                if seq < newest:
                    self.log.emit("suggest_stale_drop", skipped=seq, newest=newest)
                    continue
                lines = carry
                carry = []
                try:
                    self.suggest(lines, False, seq)
                except Exception as e:  # noqa: BLE001 — one bad batch must not kill suggestions
                    try:
                        self.log.emit("suggest_error", reason=f"thread:{type(e).__name__}:{e}")
                    except Exception:  # noqa: BLE001 — log may be closing at shutdown
                        pass
            if carry:  # defensive: never discard carried lines at shutdown
                try:
                    self.suggest(carry, False)
                except Exception:  # noqa: BLE001
                    pass
        self._suggest_thread = threading.Thread(target=loop, daemon=True)
        self._suggest_thread.start()

    def _stop_suggester(self, timeout=200.0):
        """Flush queued batches (sentinel is last-in-line) within timeout; on
        timeout the daemon thread is abandoned so shutdown stays responsive."""
        if self._suggest_thread:
            self._suggest_q.put(None)
            self._suggest_thread.join(timeout)
            self._suggest_thread = None

    def _enqueue_suggestions(self, lines):
        with self._suggest_lock:
            self._suggest_seq += 1
            self._suggest_q.put((self._suggest_seq, list(lines)))

    # -- answer-driven follow-ups (canticos-8ax) -----------------------------
    def enqueue_followup(self, question, answer):
        """TUI ask hook: hand ONE answer-driven follow-up to the background
        suggester and return immediately. The dashboard thread never waits on
        pi; validation and ingestion happen on the suggester thread."""
        self._suggest_q.put({"kind": "followup",
                             "question": dict(question),
                             "answer": str(answer)})

    def generate_followup(self, question, answer):
        """Generate at most one follow-up from a captured answer, through the
        same pi contract and `sug.validate_round` gate as a normal round.
        Failures are logged and swallowed: asking must never crash a session."""
        try:
            self.log.emit("followup_trigger", question=question.get("text"),
                          answer=answer)
            now = time.time()
            cmd = sug.followup_cmd(
                question.get("text", ""), answer,
                participants=sug.effective_participants(self.participants, self.ui),
                pi_model=self.args.pi_model,
                question_model=self.args.question_model)
            raw, failure = self._run_pi(
                cmd, sug.QUESTION_MODEL_TIMEOUT_S if self.args.question_model
                else sug.PI_TIMEOUT_S)
            if failure:
                self.log.emit("followup_error", reason=failure)
                return None
            accepted, rejected, reasons = sug.validate_followup(
                raw, self._recent_snapshot())
            if not accepted:
                self.log.emit("followup_reject", reasons=reasons,
                              rejected=rejected)
                return None
            candidate = dict(accepted[0])
            candidate.setdefault("priority", "medium")
            candidate["source"] = "followup"
            candidate["thread"] = question.get("thread") or question.get("text")
            candidate = self.slots.assign([candidate])[0]
            self.queue.ingest([candidate], now=now)
            self._write_queue_json()
            self.log.emit("followup_result", question=candidate["text"],
                          source="answer", answer=answer, reasons=reasons)
            return candidate
        except Exception as e:  # noqa: BLE001 — never let a follow-up kill the worker
            try:
                self.log.emit("followup_error",
                              reason=f"{type(e).__name__}: {e}")
            except Exception:  # noqa: BLE001
                pass
            return None

    def _recent_snapshot(self):
        """Copy the rolling window under a lock: the suggester thread reads it
        while the worker appends, and deque iteration is not mutation-safe."""
        with self._recent_lock:
            return list(self.recent_lines)

    def _remember_lines(self, lines):
        with self._recent_lock:
            self.recent_lines.extend(lines)

    def _run_pi(self, cmd, timeout):
        """Run one pi suggestion call; returns (raw_stdout, failure_reason).
        Failure strings match the suggest_error vocabulary so the strong model
        attempt and the fallback attempt log the same way."""
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        except FileNotFoundError:
            return None, "pi-not-found"
        except subprocess.TimeoutExpired:
            return None, "timeout"
        if r.returncode != 0:
            return None, f"exit-{r.returncode}"
        if not r.stdout.strip():
            return None, "empty"
        return r.stdout, None

    def _report_pi_failure(self, reason):
        """Final attempt failed; keeps the pre-canticos-7h9 stderr/event contract."""
        if reason == "pi-not-found":
            sys.stderr.write("interview-live: pi not found — suggestions skipped (transcription continues)\n")
        elif reason == "timeout":
            sys.stderr.write("interview-live: pi timed out — suggestions skipped\n")
        elif reason.startswith("exit-"):
            sys.stderr.write(f"interview-live: pi failed (exit {reason[5:]}) — suggestions skipped\n")
        if self.ui:
            self.ui.suggestion = "error"
        self.log.emit("suggest_error", reason=reason)

    def suggest(self, new_lines, first, seq=None):
        """Run one stateless suggestion round (canticos-ate). `first` is kept
        for call-site compatibility and no longer changes the prompt; `seq` lets
        the repair path honor the stale-batch guard."""
        input_lines = "\n".join(new_lines)
        # Validation sees the same rolling window the model does, plus this
        # batch's lines; the context passed to pi excludes the new lines so the
        # prompt does not duplicate them.
        context = self._recent_snapshot()
        if new_lines:
            # A batch can be longer than the window (a long pi stall coalesces
            # batches); drop only the overlapping suffix so context and new
            # lines never duplicate each other in the prompt.
            tail = list(new_lines)
            for k in range(min(len(context), len(tail)), 0, -1):
                if context[-k:] == tail[-k:]:
                    context = context[:-k]
                    break
        validation_window = context + list(new_lines)
        now = time.time()
        pending = self.queue.pending_questions(now=now)
        # canticos-47b: goal coverage from the batches so far becomes the
        # prompt's LEARNING GOALS digest; it is the same state the ranker uses.
        goals = self.queue.goal_snapshot(now=now)
        question_model = self.args.question_model
        if self.ui:
            self.ui.suggestion = "thinking"
        cmd = sug.build_pi_cmd(self.session_name, first, self.args.pi_model,
                               self.participants, self.ui, input_lines,
                               question_model=question_model,
                               window_lines=context, pending=pending,
                               now=now, goals=goals)
        # canticos-7h9: the strong model gets a soft 45s budget (P-04); any
        # timeout/failure/nonzero/empty falls back once to --pi-model.
        raw, failure = self._run_pi(
            cmd, sug.QUESTION_MODEL_TIMEOUT_S if question_model else sug.PI_TIMEOUT_S)
        degraded = False
        model_used = question_model or self.args.pi_model
        if failure and question_model:
            self.log.emit("suggest_fallback", reason=failure,
                          strong_model=question_model,
                          fallback_model=self.args.pi_model)
            model_used = self.args.pi_model
            cmd = sug.build_pi_cmd(self.session_name, first, self.args.pi_model,
                                   self.participants, self.ui, input_lines,
                                   window_lines=context, pending=pending,
                                   now=now, goals=goals)
            raw, failure = self._run_pi(cmd, sug.PI_TIMEOUT_S)
            degraded = failure is None
        if failure:
            self._report_pi_failure(failure)
            return
        out = raw.strip()
        questions, topics = core.parse_suggestion_output(out)
        questions, _rejected, reasons = sug.validate_round(
            questions, topics, validation_window)
        repaired = False
        if sug.REASON_NO_QUESTIONS in reasons:
            # canticos-ap3: exactly ONE repair round. The stale guard wins: if a
            # newer batch is already queued, a second call would waste the model
            # on context the next batch is about to replace.
            if seq is not None:
                with self._suggest_lock:
                    newest = self._suggest_seq
                if seq < newest:
                    self.log.emit("suggest_stale_drop", skipped=seq, newest=newest)
                    return
            self.log.emit("suggest_repair", reason=sug.REASON_NO_QUESTIONS,
                          rejected=out)
            repair_cmd = sug.build_pi_cmd(
                self.session_name, True, self.args.pi_model,
                self.participants, self.ui, input_lines,
                question_model=model_used, repair=out,
                window_lines=context, pending=pending, now=now, goals=goals)
            repair_timeout = (sug.PI_TIMEOUT_S if model_used == self.args.pi_model
                              else sug.QUESTION_MODEL_TIMEOUT_S)
            raw, failure = self._run_pi(repair_cmd, repair_timeout)
            if failure:
                self._reject(reasons, failure)
                return
            out = raw.strip()
            questions, topics = core.parse_suggestion_output(out)
            questions, _rejected, reasons = sug.validate_round(
                questions, topics, validation_window)
            if sug.REASON_NO_QUESTIONS in reasons:
                self._reject(reasons, None)
                return
            repaired = True
        # fill goal_id from slot keywords before ingest; explicit model tags win
        questions = self.slots.assign(questions)
        self.queue.ingest(questions, topics)
        self._write_queue_json()
        with open(self.questions_path, "a") as fh:
            fh.write(f"\n## Suggestion batch ({time.strftime('%H:%M:%S')})\n")
            if questions:
                fh.write("\nQuestions:\n")
                for q in questions:
                    fh.write(f"- {q['text']}\n")
            if topics:
                fh.write("\nTopics:\n")
                for t in topics:
                    fh.write(f"- {t['name']} ({t['priority']}): {t['note']}\n")
        self.log.emit("suggest_result",
                      input_lines=input_lines,
                      raw_output=raw,
                      questions=[q["text"] for q in questions],
                      topics=topics,
                      repaired=repaired,
                      reasons=reasons)
        if self.ui:
            self.ui.suggestion = "done (fallback)" if degraded else "done"
        else:
            # canticos-wrl plain parity: lead card + grounds + [MM:SS] +
            # three-item backlog — never the raw pi output dump.
            now = time.time()
            self._emit_shown()
            self.board_ui.participants = self.participants
            board = tui.render_plain_board(self.board_ui, now=now)
            sys.stdout.write(f"\n--- follow-up questions ({time.strftime('%H:%M:%S')}) ---{board}\n")

    def _reject(self, reasons, failure):
        """The single repair round still broke the contract (or pi failed on
        it): log the rejection and stop — no retry loops (canticos-ap3)."""
        payload = {"reasons": reasons}
        if failure:
            payload["error"] = failure
        self.log.emit("suggest_reject", **payload)
        if self.ui:
            self.ui.suggestion = "error"

    def _emit_shown(self):
        """Plain mode's rendered view is the stdout round, so every unshown
        pending question is one just printed (shown ones were flagged when
        their batch rendered). canticos-vvc — same event as the TUI frame.
        canticos-q9j — stale questions are expired first (question_dismissed
        reason='expired') and never printed as live follow-ups."""
        now = time.time()
        for q in self.queue.expire_pending(now):
            tui.emit_question(self.log.emit, "question_dismissed", q, reason="expired")
        for q in self.queue.pending_questions():
            shown = self.queue.mark_shown(q["key"])
            if shown:
                tui.emit_question(self.log.emit, "question_shown", shown)

    def _write_queue_json(self):
        participants = sug.effective_participants(self.participants, self.ui)
        data = json.dumps(self.queue.snapshot(participants=participants, now=time.time()),
                          indent=2, ensure_ascii=False)
        tmp = self.queue_path.with_suffix(".json.tmp")
        tmp.write_text(data)
        os.replace(tmp, self.queue_path)

    # -- main loop -------------------------------------------------------------
    def run(self):
        for tool, where in (("ffmpeg", "capture"), ("whisper-cli", "transcription")):
            if subprocess.run(["sh", "-c", f"command -v {tool}"], capture_output=True).returncode != 0:
                sys.stderr.write(f"interview-live: {tool} not found — required for {where}\n")
                raise SystemExit(1)

        self.log.emit("session_start", mode="replay" if self.args.from_file
                      else "replay-live" if self.args.replay else "live",
                      participants=self.participants,
                      pi_model=self.args.pi_model, out=str(self.out),
                      session=self.session_name)
        try:
            self._start_suggester()
            self.start_capture()
            if self.args.from_file or self.args.replay:
                # replay paths: wait for the conversion before transcribing
                try:
                    rc = self.ffmpeg_proc.wait(timeout=600)
                except subprocess.TimeoutExpired:
                    sys.stderr.write("interview-live: ffmpeg conversion timed out\n")
                    raise SystemExit(1)
                if rc != 0:
                    sys.stderr.write(f"interview-live: ffmpeg conversion failed (exit {rc})\n")
                    raise SystemExit(1)
                if self.args.replay:
                    dur_ms = int(cap.probe_duration(self.capture_path) * 1000)
                    self._replay_total_ms = dur_ms if dur_ms > 0 else float("inf")
            rounds = self.args.rounds if self.args.rounds else 10**9
            if self.ui:
                self._run_tui(rounds)
            else:
                try:
                    self._run_loop(rounds)
                except KeyboardInterrupt:
                    self.interrupted = True
            if not self.transcript_path.exists():
                sys.stdout.write("interview-live: no transcript captured\n")
        finally:
            self.stop_capture()
            self._stop_suggester(timeout=10.0 if self.interrupted else 200.0)
            self.log.emit("session_end", reason="interrupted" if self.interrupted
                          else "replay" if self.args.from_file
                          else "replay-live" if self.args.replay else "quit",
                          duration=round(time.time() - self.started_at, 1),
                          transcript_lines=len(self.ui.transcript) if self.ui else 0,
                          questions=len(self.queue.questions), topics=len(self.queue.topics))
            self.log.close()

    def _run_loop(self, rounds):
        """Worker loop shared by plain output and the TUI worker thread.
        When self.ui is set, events are mirrored into the dashboard state and
        nothing is written to stdout (the terminal belongs to curses).
        Suggestion batches fire on conversation events (guest turn end, long
        monologue), a manual force, or the end-of-run flush — never once per
        transcription round (canticos-2iv)."""
        ui = self.ui
        offset_ms = 0
        policy = trig.TriggerPolicy(min_segments=self.args.min_segments)
        window_s = self.args.window or self.args.every

        def on_whisper_error(kind, detail=None):
            self.log.emit("whisper_error", kind=kind, detail=detail)

        def fire(force=False):
            """Enqueue the pending batch when the policy (or a manual force)
            says so; returns True when a batch was enqueued."""
            reason = "force" if force else policy.due(time.monotonic())
            if not reason:
                return False
            drained = policy.drain()
            if not drained:
                return False
            self.log.emit("suggest_trigger", reason=reason, segments=len(drained))
            self._enqueue_suggestions(
                [core.render_segment_line(s[0], s[2], s[3], self.speaker_names)
                 for s in drained])
            return True

        for _ in range(rounds):
            if self.interrupted:
                break
            if self.args.from_file:
                pass  # one-shot: conversion already finished above
            elif self.args.replay:
                if self._replay_pos_ms >= self._replay_total_ms:
                    break  # streamed to the end of the recording
            else:
                time.sleep(self.args.every)
                if self.ffmpeg_proc.poll() is not None:
                    sys.stderr.write("interview-live: ffmpeg capture exited early — stopping"
                                     f" (see {self.work / 'ffmpeg.log'})\n")
                    break
            # Decide AFTER the round's wait: the quiet floor is measured across
            # it, so a guest turn end observed last round can fire now.
            if ui is not None and ui.force_request:
                ui.force_request = False
                fire(force=True)
            else:
                fire()
            if self.args.replay:
                # slice the next window and transcribe it as if it just arrived
                win_path = self.work / f"window-{self._replay_pos_ms}.wav"
                wr = subprocess.run(
                    cap.build_window_cmd(self.capture_path,
                                         self._replay_pos_ms / 1000.0, window_s, win_path),
                    capture_output=True)
                if wr.returncode != 0:
                    sys.stderr.write("interview-live: replay window slice failed — stopping\n")
                    break
                segs = whisper.run_whisper(self.whisper, self.args.language,
                                           0, win_path, shift_ms=self._replay_pos_ms,
                                           on_error=on_whisper_error)
                self._replay_pos_ms += int(round(window_s * 1000))
            else:
                segs = whisper.run_whisper(self.whisper, self.args.language, offset_ms,
                                           self.capture_path, on_error=on_whisper_error)
            if segs:
                lines = []
                for start, end, spk, text in segs:
                    offset_ms = max(offset_ms, end)
                    lines.append(core.render_segment_line(start, spk, text, self.speaker_names))
                    if ui:
                        ui.transcript.append((start, spk, text))
                    self.log.emit("transcript_segment", start_ms=start, end_ms=end,
                                  speaker=spk, text=text)
                with open(self.transcript_path, "a") as fh:
                    fh.write("\n".join(lines) + "\n")
                self._remember_lines(lines)
                if ui:
                    ui.last_offset_ms = offset_ms
                else:
                    sys.stdout.write("\n".join(lines) + "\n")
                policy.add(segs, time.monotonic())
            if self.args.from_file:
                break  # replay: one pass
        # Never lose the tail: flush the last batch (subject to the same
        # --min-segments floor that suppresses suggestions in noise-only runs).
        if policy.pending_count >= self.args.min_segments:
            fire(force=True)

    def _run_tui(self, rounds):
        """Run the worker loop on a background thread while curses owns the terminal."""
        ui = self.ui
        errors = []

        def worker():
            try:
                self._run_loop(rounds)
            except BaseException as e:  # noqa: BLE001 — worker must never kill curses
                errors.append(e)
                self.interrupted = True

        th = threading.Thread(target=worker, daemon=True)
        th.start()
        try:
            tui.curses.wrapper(tui.run_dashboard, ui, self.args.participants,
                               stop_check=lambda: self.interrupted)
        except Exception as e:  # noqa: BLE001
            sys.stderr.write(f"interview-live: TUI error ({e}) — stopping\n")
            self.interrupted = True
        self.interrupted = True  # q pressed or worker stopped — end the loop
        self.log.emit("participants_set", participants=ui.participants)
        # the dashboard prompt may have changed participants after the last
        # suggestion batch — refresh the snapshot so queue.json stays truthful
        self.participants = ui.participants
        self._write_queue_json()
        th.join(timeout=10)
        if errors and not isinstance(errors[0], KeyboardInterrupt):
            sys.stderr.write(f"interview-live: worker stopped unexpectedly: {errors[0]!r}\n")


def default_whisper_model():
    """Best local model wins: large-v3-turbo markedly outperforms base on
    domain terms (verified against gold-standard replay), same speed class
    on GPU builds; falls back to the base path."""
    models = Path.home() / "models"
    for name in ("ggml-large-v3-turbo.bin", "ggml-base.bin"):
        if (models / name).exists():
            return str(models / name)
    return str(models / "ggml-base.bin")


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="interview-live",
        description="Live Mom Test interview copilot: transcribe mic+system (diarized) and get pi-suggested follow-up questions.",
    )
    p.add_argument("--from", dest="from_file", metavar="FILE",
                   help="Replay an existing recording instead of live capture (expects L=interviewer, R=guest stereo or mic-track/system-track). One batch transcription pass.")
    p.add_argument("--replay", metavar="FILE",
                   help="Validation mode: stream an existing recording through the rolling window pipeline as if live (no mic), so transcript and suggested questions can be checked against a gold-standard conversation. Works with --tui and --rounds.")
    p.add_argument("--window", type=float, default=0.0,
                   help="Audio seconds per transcription window in --replay (default: the --every value)")
    p.add_argument("--rounds", type=int, default=0, help="Transcription rounds before exit (default: infinite until Ctrl+C)")
    p.add_argument("--every", type=float, default=5.0, help="Seconds between transcription passes (default: 5; lower = fresher transcript, more whisper calls)")
    p.add_argument("--min-segments", type=int, default=1, help="New segment lines that trigger a suggestion batch (default: 1)")
    p.add_argument("--participants", type=int, default=2,
                   help="Number of participants in the conversation (default: 2; drives the TUI roster and the pi system prompt)")
    p.add_argument("--tui", dest="tui", action="store_true", default=None,
                   help="Force the curses dashboard (default: auto — TUI on an interactive terminal)")
    p.add_argument("--no-tui", dest="tui", action="store_false",
                   help="Disable the dashboard and use plain stdout output")
    p.add_argument("--pi-model", metavar="MODEL",
                   default=os.environ.get("INTERVIEW_PI_MODEL", "qwen-token-plan-individual/qwen3.8-flash"),
                   help="pi model for suggestions (default: $INTERVIEW_PI_MODEL or qwen-token-plan-individual/qwen3.8-flash)")
    p.add_argument("--question-model", metavar="MODEL",
                   default=os.environ.get("INTERVIEW_QUESTION_MODEL") or None,
                   help="Stronger pi model for question generation with a 45s soft budget; on timeout/failure it falls back to --pi-model (default: $INTERVIEW_QUESTION_MODEL; unset = no strong-model pass)")
    p.add_argument("--whisper-model", metavar="PATH", help="Whisper model file (default: best local of ~/models/ggml-large-v3-turbo.bin, ggml-base.bin, or $WHISPER_MODEL)")
    p.add_argument("--language", default="es",
                   help="Whisper language code or 'auto' (default: es — per-window auto misdetects on short clips)")
    p.add_argument("--session", metavar="NAME",
                   help="Session directory name under --out (default: interview-YYYYMMDD-HHMMSS). Reusing a name appends to that session.")
    p.add_argument("--speaker", metavar="N=NAME", action="append", default=None,
                   help="Name a diarized speaker id for this run, e.g. --speaker 0=You --speaker 1=Ana. Repeatable; persists to speakers.json and renders '[ts] Name: text' in the transcript.")
    p.add_argument("--set-speaker", metavar="N=NAME", action="append", default=None,
                   dest="set_speaker",
                   help="Post-hoc tagging: rewrite an existing session's transcript labels (requires --session). No re-transcription.")
    p.add_argument("--adopt", action="store_true",
                   help="One-time migration: move legacy flat artifacts (capture.wav, transcript.txt, …) from the --out root into an adopt-<ts> session dir so --list shows them")
    p.add_argument("--diarize", action="store_true",
                   help="Re-diarize the session's capture.wav with pyannote (N speakers; requires --session, HF_TOKEN; first run downloads ~2GB torch) and re-attribute transcript lines by timestamp overlap")
    p.add_argument("--list", action="store_true",
                   help="List sessions under --out newest-first (name, date, duration, recording, transcript lines, questions) and exit")
    p.add_argument("--json", action="store_true",
                   help="With --list: machine-readable JSON output")
    p.add_argument("--out", metavar="DIR", help="Sessions ROOT dir — each run works in <out>/<session>/ (default: $INTERVIEW_DIR or ~/Interviews)")
    args = p.parse_args(argv)
    if args.from_file and args.rounds:
        sys.stderr.write("interview-live: --rounds is ignored with --from\n")
    if args.from_file and args.replay:
        p.error("--from and --replay are mutually exclusive")
    if not 1 <= args.participants <= 20:
        p.error("--participants must be between 1 and 20")
    if args.session is not None and ("/" in args.session or "\\" in args.session
                                     or ".." in args.session
                                     or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._+-]*", args.session)):
        p.error("--session must be a filesystem-safe name (no slashes, no '..')")
    if args.json and not args.list:
        p.error("--json requires --list")
    if args.diarize and not args.session:
        p.error("--diarize requires --session NAME")
    if args.diarize and (args.set_speaker or args.list or args.adopt):
        p.error("--diarize cannot be combined with --set-speaker/--list/--adopt")
    if args.speaker:
        args.speaker = parse_speaker_specs(p, args.speaker)
    if args.set_speaker:
        args.set_speaker = parse_speaker_specs(p, args.set_speaker)
        if not args.session:
            p.error("--set-speaker requires --session NAME")
    return args


def parse_speaker_specs(parser, values):
    """['1=Ana', ...] -> {1: 'Ana'}; malformed specs are usage errors."""
    specs = {}
    for raw in values or []:
        sid, sep, name = raw.partition("=")
        if not sep or not sid.strip().isdigit() or not name.strip():
            parser.error("--speaker/--set-speaker must be N=Name (e.g. --speaker 1=Ana)")
        specs[int(sid.strip())] = name.strip()
    return specs


TRANSCRIPT_LINE_RE = re.compile(r"^\[([^\]]+)\]\s+\(speaker (\d+)\)\s?(.*)$")


def cmd_set_speaker(work, specs):
    """Post-hoc tagging (canticos-uzv): rewrite transcript.txt labels for named
    speakers and persist speakers.json. No re-transcription; unnamed ids keep
    their legacy markers."""
    names_path = work / "speakers.json"
    names = {}
    if names_path.exists():
        try:
            loaded = json.loads(names_path.read_text())
            if isinstance(loaded, dict):
                names = {str(k): v for k, v in loaded.items()
                         if isinstance(v, dict) and v.get("name")}
        except (json.JSONDecodeError, OSError):
            names = {}
    names.update({str(k): {"name": v} for k, v in specs.items()})
    names.setdefault("0", {"name": "You"})
    tp = work / "transcript.txt"
    if not tp.exists():
        sys.stderr.write(f"interview-live: no transcript in {work} — nothing to tag\n")
        return 1
    out_lines, renamed = [], 0
    for line in tp.read_text().splitlines():
        m = TRANSCRIPT_LINE_RE.match(line)
        if m and m.group(2) in names:
            out_lines.append(f"[{m.group(1)}] {names[m.group(2)]['name']}: {m.group(3)}")
            renamed += 1
        else:
            out_lines.append(line)
    tp.write_text("\n".join(out_lines) + ("\n" if out_lines else ""))
    names_path.write_text(json.dumps(names, indent=2, ensure_ascii=False))
    roster = ", ".join(f"{k}={v['name']}" for k, v in sorted(names.items(), key=lambda kv: int(kv[0])))
    sys.stdout.write(f"interview-live: tagged {renamed} lines in {work} — {roster}\n")
    return 0


SESSION_ARTIFACTS = ("events.jsonl", "transcript.txt", "capture.wav",
                     "questions.md", "queue.json", "speakers.json", "ffmpeg.log")


def load_speakers_names(spk_path):
    """speakers.json -> {str_id: {"name"}}; corrupt/absent file -> {}."""
    if not spk_path.exists():
        return {}
    try:
        loaded = json.loads(spk_path.read_text())
        if isinstance(loaded, dict):
            return {str(k): v for k, v in loaded.items()
                    if isinstance(v, dict) and v.get("name")}
    except (json.JSONDecodeError, OSError):
        pass
    return {}


def cmd_diarize(work, runner=None):
    """--diarize (canticos-q73): pyannote the session recording, re-attribute
    transcript lines by timestamp overlap, write speakers.json placeholders.
    Never re-transcribes; unmatched lines keep their original ids."""
    runner = runner or dia.run_pyannote
    wav = work / "capture.wav"
    tp = work / "transcript.txt"
    if not wav.exists():
        sys.stderr.write(f"interview-live: no capture.wav in {work} — nothing to diarize\n")
        return 1
    if not tp.exists():
        sys.stderr.write(f"interview-live: no transcript.txt in {work} — nothing to re-label\n")
        return 1
    sys.stderr.write("interview-live: running pyannote diarization"
                     " (first run may download ~2GB torch + models)…\n")
    errors = []

    def runner(wav):
        return dia.run_pyannote(wav, on_error=lambda k, d: errors.append((k, d)))

    rttm = runner(wav)
    if rttm is None:
        sys.stderr.write("interview-live: diarization failed — check HF_TOKEN"
                         " (gated pyannote/speaker-diarization-3.1) and uv output\n")
        if errors:
            kind, detail = errors[-1]
            sys.stderr.write(f"  reason: {kind}" + (f": {detail}" if detail else "") + "\n")
        return 1
    turns = dia.parse_rttm(rttm)
    lines = tp.read_text().splitlines()
    new_lines, label_ids = dia.assign_turn_speakers(lines, turns)
    tp.write_text("\n".join(new_lines) + ("\n" if new_lines else ""))
    spk_path = work / "speakers.json"
    existing_names = load_speakers_names(spk_path)
    speakers = dia.placeholder_speakers(label_ids, existing_names)
    spk_path.write_text(json.dumps(speakers, indent=2, ensure_ascii=False))
    try:
        log = evlog.EventLog(work / "events.jsonl")
        log.emit("diarize_done", speakers=len(label_ids), turns=len(turns),
                 relabeled=sum(1 for a, b in zip(lines, new_lines) if a != b))
        log.close()
    except OSError:
        pass
    roster = ", ".join(f"{sid}={names['name']}"
                       for sid, names in sorted(speakers.items(), key=lambda kv: int(kv[0])))
    sys.stdout.write(f"interview-live: diarized {len(label_ids)} speaker(s),"
                     f" {len(turns)} turns — {roster}\n"
                     f"  rename with: interview-live --session {work.name} --set-speaker N=Name\n")
    return 0


def sessions_root(args):
    """Resolve the sessions ROOT without constructing a run."""
    return Path(args.out or os.environ.get("INTERVIEW_DIR") or str(Path.home() / "Interviews"))


def find_sessions(root):
    """Session dirs under root = subdirs holding at least one known artifact."""
    if not root.is_dir():
        return []
    return [d for d in sorted(root.iterdir()) if d.is_dir()
            and any((d / a).exists() for a in SESSION_ARTIFACTS)]


def session_summary(d):
    """Dir -> summary dict read from artifacts (events first, tolerant of gaps)."""
    start_ts = end_ts = duration = None
    events = d / "events.jsonl"
    if events.exists():
        for line in events.read_text().splitlines():
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            if rec.get("type") == "session_start":
                start_ts = rec.get("ts")
            elif rec.get("type") == "session_end":
                end_ts = rec.get("ts")
                duration = rec.get("duration")
    transcript_lines = 0
    tp = d / "transcript.txt"
    if tp.exists():
        transcript_lines = sum(1 for l in tp.read_text().splitlines() if l.strip())
    questions = 0
    qp = d / "queue.json"
    if qp.exists():
        try:
            questions = len(json.loads(qp.read_text()).get("questions") or [])
        except (json.JSONDecodeError, OSError):
            questions = 0
    wav = d / "capture.wav"
    recording_bytes = wav.stat().st_size if wav.exists() else None
    return {"name": d.name, "start_ts": start_ts, "end_ts": end_ts,
            "duration_s": duration, "transcript_lines": transcript_lines,
            "questions": questions, "recording_bytes": recording_bytes}


def fmt_duration(sec):
    h, rem = divmod(int(sec), 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def fmt_bytes(n):
    if n < 1024:
        return f"{n} B"
    for unit in ("KB", "MB", "GB"):
        n /= 1024.0
        if n < 1024 or unit == "GB":
            return f"{n:.1f} {unit}"
    return f"{n:.1f} GB"


def cmd_list(root, as_json):
    """--list: print session summaries newest-first (or JSON). Exit 0 always
    when the root is readable — an empty history is not an error."""
    summaries = [session_summary(d) for d in find_sessions(root)]
    summaries.sort(key=lambda s: s["start_ts"]
                   if s["start_ts"] is not None
                   else (root / s["name"]).stat().st_mtime,
                   reverse=True)
    if as_json:
        sys.stdout.write(json.dumps({"sessions": summaries}, indent=2, ensure_ascii=False) + "\n")
        return 0
    legacy_flat = any((root / a).exists() for a in SESSION_ARTIFACTS)
    if not summaries:
        sys.stdout.write(f"interview-live: no sessions in {root}\n")
        if legacy_flat:
            sys.stdout.write("Note: legacy flat artifacts in the root —"
                             " run `interview-live --adopt` to move them into a session.\n")
        return 0
    sys.stdout.write(f"Sessions in {root} (newest first):\n")
    for s in summaries:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(s["start_ts"])) \
            if s["start_ts"] else "?"
        dur = f"{fmt_duration(s['duration_s'])} min" if s["duration_s"] else "—"
        rec = (f"{fmt_bytes(s['recording_bytes'])} recording"
               if s["recording_bytes"] is not None else "no recording")
        sys.stdout.write(f"  {s['name']}  {when}  {dur}  {rec}"
                         f"  {s['transcript_lines']} lines  {s['questions']} questions\n")
    if legacy_flat:
        sys.stdout.write("\nNote: legacy flat artifacts in the root —"
                         " run `interview-live --adopt` to move them into a session.\n")
    return 0


def cmd_adopt(root):
    """--adopt (canticos-bm7): move legacy flat artifacts and window-*.wav
    slices from the root into one adopt-<ts> session dir (named after the
    oldest artifact). Idempotent: nothing flat -> friendly no-op, exit 0."""
    if not root.is_dir():
        sys.stdout.write(f"interview-live: nothing to adopt in {root} (root missing)\n")
        return 0
    flat = [a for a in SESSION_ARTIFACTS if (root / a).exists()]
    windows = sorted(root.glob("window-*.wav"))
    if not flat and not windows:
        sys.stdout.write(f"interview-live: nothing to adopt in {root} (no flat artifacts)\n")
        return 0
    mtimes = [(root / a).stat().st_mtime for a in flat] + [w.stat().st_mtime for w in windows]
    base = "adopt-" + time.strftime("%Y%m%d-%H%M%S", time.localtime(min(mtimes)))
    work = root / base
    n = 1
    while work.exists():
        n += 1
        work = root / f"{base}-{n}"
    work.mkdir(parents=True)
    moved = flat + [w.name for w in windows]
    for a in flat:
        os.replace(root / a, work / a)
    for w in windows:
        os.replace(w, work / w.name)
    sys.stdout.write(f"interview-live: adopted {len(moved)} files into {work}\n"
                     f"  {', '.join(sorted(moved))}\n")
    return 0


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.list:
        raise SystemExit(cmd_list(sessions_root(args), args.json))
    if args.adopt:
        raise SystemExit(cmd_adopt(sessions_root(args)))
    if args.diarize:
        raise SystemExit(cmd_diarize(sessions_root(args) / args.session))
    if args.set_speaker:
        work = sessions_root(args) / args.session
        if not work.is_dir():
            sys.stderr.write(f"interview-live: no such session: {work}\n")
            raise SystemExit(1)
        raise SystemExit(cmd_set_speaker(work, args.set_speaker))
    tool = InterviewLive(args)
    # choose the dashboard: explicit flag wins; otherwise auto when stdout is a
    # real terminal and curses is available (pipes/scripts stay plain)
    if args.tui is True:
        if not (sys.stdout.isatty() and tui.available()):
            sys.stderr.write("interview-live: --tui needs an interactive terminal with curses — use --no-tui\n")
            raise SystemExit(2)
        tool.ui = tui.TuiState(queue=tool.queue, speaker_names=tool.speaker_names,
                               emit=tool.log.emit)
    elif args.tui is None and sys.stdout.isatty() and tui.available():
        tool.ui = tui.TuiState(queue=tool.queue, speaker_names=tool.speaker_names,
                               emit=tool.log.emit)
    if tool.ui is not None:
        # canticos-8ax: a captured answer queues one follow-up on the
        # suggester thread; the dashboard never blocks on the model.
        tool.ui.followup = tool.enqueue_followup

    def handler(signum, frame):
        tool.interrupted = True

    signal.signal(signal.SIGINT, handler)
    signal.signal(signal.SIGTERM, handler)
    try:
        tool.run()
    finally:
        tool.stop_capture()


if __name__ == "__main__":
    main()