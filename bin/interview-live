#!/usr/bin/env python3
# Purpose: Live Mom Test interview copilot — transcribe a meeting (mic + system
#   audio, diarized) in rolling windows and have pi suggest follow-up questions.
# Responsibilities:
#   - Capture mic/system as L/R stereo (L=mic, R=monitor) so whisper -di labels speakers 0/1
#   - Incrementally transcribe new audio with whisper-cli at rising -ot offsets
#   - Accumulate a deduped transcript file (transcript.txt) with speaker tags
#   - Every new-segment batch, call pi (persistent --session) with the Mom Test
#     methodology in the system prompt; save suggested questions to questions.md
#   - Support --from <recording> replay mode for already-recorded interviews
# Rationale: canticos-59c — the Mom Test (Fitzpatrick) demands digging into
#   specific past instances; the copilot keeps questions grounded in what was
#   actually said. Using pi (not raw OpenRouter) gives access to the full model
#   catalog with existing auth. Stereo -di caps at 2 speakers — enough for the
#   2-channel design (interviewer/guest) without pyannote.
import argparse
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

MOM_SYSTEM_PROMPT = """You are a Mom Test interviewing coach (methodology from Rob Fitzpatrick's "The Mom Test").

The Mom Test core rules:
- Talk about THEIR life, not yours. Never pitch, solve, or brag.
- Ask about specific facts and events from the PAST — the last time it happened, what
  they did, who was involved, what it cost (time/money), what happened right before/after.
- Do not ask about hypotheticals ("would you...?") or opinions ("do you think...?")
  — people answer those with lies and compliments.
- Follow up on the 3 big lies: compliments ("great idea"), hypotheticals, and
  generosities ("I'd definitely buy it", "I'll introduce you to X").
- When you hear a strong signal (a specific past problem, emotion, a number, a name),
  dig deeper: "When did that last happen?", "What did you do about it?", "How much
  did it cost you?".
- Keep the interviewer:interviewee speech ratio low — questions short, interviewee talks most.

The transcript lines are prefixed with [MM:SS] and (speaker N). speaker 0 = interviewer (you),
speaker 1 = guest.

Your job: examine the NEW transcript lines, find the strongest signal moments, and
suggest 2-4 concrete follow-up questions (grounded in what the guest actually said,
in the language the conversation uses) that a good Mom Test interviewer would ask
NEXT. Output ONLY the numbered questions, one per line, no preamble.
"""

SEGMENT_RE = re.compile(
    r"\[(\d{2}):(\d{2}):(\d{2})\.\d{3} --> (\d{2}):(\d{2}):(\d{2})\.\d{3}\]\s*\(speaker (\d)\)\s+(.*)"
)


def ts_to_ms(h, m, s):
    return (int(h) * 3600 + int(m) * 60 + int(s)) * 1000


def fmt_ms(ms):
    s = ms // 1000
    return f"{s // 3600:02d}:{s // 60 % 60:02d}:{s % 60:02d}"


class InterviewLive:
    def __init__(self, args):
        self.args = args
        self.out = Path(args.out or os.environ.get("INTERVIEW_DIR") or str(Path.home() / "Interviews"))
        self.out.mkdir(parents=True, exist_ok=True)
        self.transcript_path = self.out / "transcript.txt"
        self.questions_path = self.out / "questions.md"
        self.capture_path = self.out / "capture.wav"
        self.whisper = args.whisper_model or os.environ.get("WHISPER_MODEL") or str(Path.home() / "models" / "ggml-base.bin")
        self.font = None
        self.ffmpeg_proc = None
        self.interrupted = False

    # -- capture ---------------------------------------------------------------
    def devices(self):
        mic = os.environ.get("INTERVIEW_MIC")
        monitor = os.environ.get("INTERVIEW_MONITOR")
        if mic and monitor:
            return mic, monitor
        try:
            mic = subprocess.run(["pactl", "get-default-source"], capture_output=True, text=True, check=True).stdout.strip()
            sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, check=True).stdout.strip()
            return mic, f"{sink}.monitor"
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            sys.stderr.write("interview-live: cannot resolve audio devices — set INTERVIEW_MIC/INTERVIEW_MONITOR\n")
            raise SystemExit(1) from e

    def start_capture(self):
        if self.args.from_file:
            cmd = self._from_cmd()
        else:
            mic, monitor = self.devices()
            cmd = [
                "ffmpeg", "-hide_banner", "-nostats", "-loglevel", "warning", "-nostdin",
                "-f", "pulse", "-i", mic,
                "-f", "pulse", "-i", monitor,
                "-filter_complex",
                "[0:a]pan=mono|c0=c0[m0];[1:a]pan=mono|c0=c0[m1];[m0][m1]join=inputs=2:channel_layout=stereo[a]",
                "-map", "[a]", "-ar", "16000", str(self.capture_path),
            ]
        self.ffmpeg_proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _from_cmd(self):
        """Build the replay conversion. Handles two audio streams (meeting-rec
        track0=mic / track1=monitor) or one stereo stream (channel0=mic,
        channel1=monitor), decided by ffprobe."""
        try:
            p = subprocess.run(
                ["ffprobe", "-v", "error", "-select_streams", "a",
                 "-show_entries", "stream=channels", "-of", "csv=p=0", str(self.args.from_file)],
                capture_output=True, text=True, timeout=30)
            streams = [ln for ln in p.stdout.splitlines() if ln.strip()]
        except (subprocess.CalledProcessError, FileNotFoundError):
            streams = []
        if len(streams) >= 2:
            flt = "[0:a:0]pan=mono|c0=c0[m0];[0:a:1]pan=mono|c0=c0[m1];[m0][m1]join=inputs=2:channel_layout=stereo[a]"
        else:
            # single stream: use its first two channels as mic / monitor
            flt = "[0:a]pan=mono|c0=c0[m0];[0:a]pan=mono|c0=c1[m1];[m0][m1]join=inputs=2:channel_layout=stereo[a]"
        return [
            "ffmpeg", "-hide_banner", "-nostats", "-loglevel", "warning", "-y",
            "-i", str(self.args.from_file),
            "-filter_complex", flt,
            "-map", "[a]", "-ar", "16000", str(self.capture_path),
        ]

    def stop_capture(self):
        if self.ffmpeg_proc and self.ffmpeg_proc.poll() is None:
            self.ffmpeg_proc.terminate()
            try:
                self.ffmpeg_proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.ffmpeg_proc.kill()

    # -- transcription ---------------------------------------------------------
    def transcribe(self, offset_ms):
        cmd = [
            "whisper-cli", "-m", self.whisper, "-l", self.args.language,
            "-di", "-ot", str(offset_ms), "-f", str(self.capture_path),
        ]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            sys.stderr.write(f"interview-live: whisper-cli failed (exit {r.returncode})\n")
            return []
        segs = []
        for line in r.stdout.splitlines():
            m = SEGMENT_RE.match(line.strip())
            if not m:
                continue
            start, end, spk, text = ts_to_ms(*m.groups()[:3]), ts_to_ms(*m.groups()[3:6]), m.group(7), m.group(8)
            if start >= offset_ms:
                segs.append((start, end, spk, text))
        return segs

    # -- suggestions -----------------------------------------------------------
    def suggest(self, new_lines, session_name, first):
        cmd = ["pi", "--session-id", session_name, "--print"]
        if first:
            cmd += ["--system-prompt", MOM_SYSTEM_PROMPT]
        if self.args.pi_model:
            cmd += ["--model", self.args.pi_model]
        cmd += ["\n".join(new_lines)]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
        except FileNotFoundError:
            sys.stderr.write("interview-live: pi not found — suggestions skipped (transcription continues)\n")
            return
        except subprocess.TimeoutExpired:
            sys.stderr.write("interview-live: pi timed out — suggestions skipped\n")
            return
        if r.returncode != 0:
            sys.stderr.write(f"interview-live: pi failed (exit {r.returncode}) — suggestions skipped\n")
            return
        out = r.stdout.strip()
        if out:
            with open(self.questions_path, "a") as fh:
                fh.write(f"\n## Suggestion batch ({time.strftime('%H:%M:%S')})\n{out}\n")
            sys.stdout.write(f"\n--- follow-up questions ({time.strftime('%H:%M:%S')}) ---\n{out}\n\n")

    # -- main loop -------------------------------------------------------------
    def run(self):
        for tool, where in (("ffmpeg", "capture"), ("whisper-cli", "transcription")):
            if subprocess.run(["sh", "-c", f"command -v {tool}"], capture_output=True).returncode != 0:
                sys.stderr.write(f"interview-live: {tool} not found — required for {where}\n")
                raise SystemExit(1)

        self.start_capture()
        if self.args.from_file:
            # replay: wait for the conversion to finish before transcribing
            try:
                rc = self.ffmpeg_proc.wait(timeout=600)
            except subprocess.TimeoutExpired:
                sys.stderr.write("interview-live: ffmpeg conversion timed out\n")
                raise SystemExit(1)
            if rc != 0:
                sys.stderr.write(f"interview-live: ffmpeg conversion failed (exit {rc})\n")
                raise SystemExit(1)
        offset_ms = 0
        session_name = f"interview-{time.strftime('%Y%m%d-%H%M%S')}"
        first = True
        pending = []
        rounds = self.args.rounds if self.args.rounds else 10**9
        try:
            for _ in range(rounds):
                if self.interrupted:
                    break
                if self.args.from_file:
                    pass  # conversion already finished above
                else:
                    time.sleep(self.args.every)
                    if self.ffmpeg_proc.poll() is not None:
                        sys.stderr.write("interview-live: ffmpeg capture exited early — stopping\n")
                        break
                segs = self.transcribe(offset_ms)
                if segs:
                    lines = []
                    for start, end, spk, text in segs:
                        offset_ms = max(offset_ms, end)
                        line = f"[{fmt_ms(start)}] (speaker {spk}) {text}"
                        lines.append(line)
                    with open(self.transcript_path, "a") as fh:
                        fh.write("\n".join(lines) + "\n")
                    sys.stdout.write("\n".join(lines) + "\n")
                    pending.extend(lines)
                    if len(pending) >= self.args.min_segments:
                        self.suggest(pending, session_name, first)
                        pending = []
                        first = False
                if self.args.from_file:
                    break  # replay: one pass
        except KeyboardInterrupt:
            self.interrupted = True
        finally:
            self.stop_capture()
            if not self.transcript_path.exists():
                sys.stdout.write("interview-live: no transcript captured\n")


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="interview-live",
        description="Live Mom Test interview copilot: transcribe mic+system (diarized) and get pi-suggested follow-up questions.",
    )
    p.add_argument("--from", dest="from_file", metavar="FILE",
                   help="Replay an existing recording instead of live capture (expects L=interviewer, R=guest stereo or mic-track/system-track).")
    p.add_argument("--live", action="store_true", default=True,
                   help="Live capture mode (default; explicit for clarity)")
    p.add_argument("--rounds", type=int, default=0, help="Transcription rounds before exit (default: infinite until Ctrl+C)")
    p.add_argument("--every", type=float, default=10.0, help="Seconds between transcription passes (default: 10)")
    p.add_argument("--min-segments", type=int, default=1, help="New segment lines that trigger a suggestion batch (default: 1)")
    p.add_argument("--pi-model", metavar="MODEL",
                   default=os.environ.get("INTERVIEW_PI_MODEL", "qwen-token-plan-individual/qwen3.8-flash"),
                   help="pi model for suggestions (default: $INTERVIEW_PI_MODEL or qwen-token-plan-individual/qwen3.8-flash)")
    p.add_argument("--whisper-model", metavar="PATH", help="Whisper model file (default: $WHISPER_MODEL or ~/models/ggml-base.bin)")
    p.add_argument("--language", default="auto", help="Whisper language code or 'auto' (default: auto)")
    p.add_argument("--out", metavar="DIR", help="Output dir (default: $INTERVIEW_DIR or ~/Interviews)")
    args = p.parse_args(argv)
    if args.from_file and args.rounds:
        sys.stderr.write("interview-live: --rounds is ignored with --from\n")
    return args


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])
    tool = InterviewLive(args)

    def handler(signum, frame):
        tool.interrupted = True

    signal.signal(signal.SIGINT, handler)
    signal.signal(signal.SIGTERM, handler)
    try:
        tool.run()
    finally:
        tool.stop_capture()


if __name__ == "__main__":
    main()